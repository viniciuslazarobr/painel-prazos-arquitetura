# 1. Credenciais do Supabase (Obrigatórias)
# Crie um projeto gratuito em https://supabase.com
# Copie de: Project Settings -> API
SUPABASE_URL=https://seu-projeto-vendas.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Senha de Acesso ao Painel Web (Opcional - Padrão: prazos2026)
# Cada usuário pode alterar sua senha individual no próprio painel
DASHBOARD_PASSWORD=prazos2026
DASHBOARD_USER=admin

# 3. Fuso horário operacional (Padrão: America/Sao_Paulo)
TIMEZONE=America/Sao_Paulo

# 4. Telegram Bot Token (Opcional)
# Se não for usar o Telegram, deixe em branco ou comente esta linha.
# O painel notificará diretamente no navegador (estilo Google Notificações).
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
